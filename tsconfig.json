{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["bun", "node", "chrome"],
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": ["relay", "protocol", "vite.config.ts", "extension"]
}
